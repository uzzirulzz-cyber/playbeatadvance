# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for PlayBeat Digital database persistence.
MONGODB_URI=

# ADMIN_PASSWORD: Secure admin panel master password (REQUIRED for admin access).
# Must be set via environment variables or secure secrets management.
# DO NOT COMMIT ACTUAL PASSWORD TO REPOSITORY.
REACT_APP_ADMIN_PASSWORD=

# IPTV_PASSWORD: IPTV streaming API password for M3U playlist generation.
# Used with IPTV usernames to generate streaming URLs.
REACT_APP_IPTV_PASSWORD=

# JAZZCASH_MERCHANT_ID: JazzCash payment gateway merchant identifier.
REACT_APP_JAZZCASH_MERCHANT_ID=

# JAZZCASH_PASSWORD: JazzCash API authentication password.
REACT_APP_JAZZCASH_PASSWORD=

# JAZZCASH_INTEGRITY_SALT: JazzCash HMAC integrity hash salt for request signing.
REACT_APP_JAZZCASH_INTEGRITY_SALT=

